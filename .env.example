# ─── Database ────────────────────────────────────────
POSTGRES_DB=smartride
POSTGRES_USER=smartride_user
POSTGRES_PASSWORD=smartride_pass_2024
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Django ──────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ─────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# ─── CORS ────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── JazzCash ────────────────────────────────────────
JAZZCASH_MERCHANT_ID=your_merchant_id
JAZZCASH_PASSWORD=your_password
JAZZCASH_INTEGRITY_SALT=your_integrity_salt
JAZZCASH_SANDBOX=True
JAZZCASH_SANDBOX_URL=https://sandbox.jazzcash.com.pk/ApplicationAPI/API/Payment/DoTransaction
JAZZCASH_LIVE_URL=https://payments.jazzcash.com.pk/ApplicationAPI/API/Payment/DoTransaction
JAZZCASH_RETURN_URL=http://localhost:5173/payment/callback

# ─── Cloudinary ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Frontend ────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000/ws
